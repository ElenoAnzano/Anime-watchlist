// use prisma-8

model Rating {
  id        Int      @id @default(autoincrement())
  animeId   Int
  score     Int
  createdAt DateTime @default(now())

  @@index([animeId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  animeId   Int
  content   String
  createdAt DateTime @default(now())

  @@index([animeId])
}
